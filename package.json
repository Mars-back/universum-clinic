{
  "name": "universum-clinic",
  "version": "1.0.0",
  "private": true,
  "description": "Мінімальний облік пацієнтів",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || 24.x"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "build": "node --check src/server.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:smoke": "node scripts/smoke-test.js",
    "test": "node --test tests/clinic.test.js",
    "check": "npm run format:check && npm run lint && npm run build && npm run test:smoke && npm test",
    "prepare": "husky"
  },
  "dependencies": {
    "better-sqlite3": "12.11.1",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "globals": "16.5.0",
    "husky": "9.1.7",
    "prettier": "3.9.10"
  }
}
